# Copy to .env.local (git ignores it) and fill in the values. Names only here, never real values.
# Locally: .env.local. On Vercel: Project Settings, Environment Variables.

# Groq (live model). SECRET.
GROQ_API_KEY=
# Model name, so you can switch without a code change. Verify the current name in Groq's docs.
GROQ_MODEL=

# Supabase (database). Both are SECRET. The service_role key bypasses row level security: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
